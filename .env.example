# ==============================================================================
# MODELO DE CONFIGURAÇÃO DE AMBIENTE (.env.example)
# Copie este arquivo para '.env' e preencha suas chaves com segurança.
# NUNCA comite o arquivo '.env' no Git.
# ==============================================================================

# 1. Provedor de IA - Google Gemini (Obtenha em: https://aistudio.google.com)
GEMINI_API_KEY=

# 2. Provedor de IA - OpenAI (Obtenha em: https://platform.openai.com)
OPENAI_API_KEY=

# 3. Provedor de IA - Groq (Obtenha em: https://console.groq.com)
GROQ_API_KEY=

# Configuração do Banco de Dados
DATABASE_URL=sqlite:///./rh_database.db
